+    private static class Achado {
+        int mob, item, qtd, mapa, sa, x, y;
+        double chance;
+    }
+
+    /** Monstros vivos agora com drop interessante perto do n\u00edvel do jogador (ou Dofus), contados por sub\u00e1rea. */
+    private Achado achado(Player p, int saFiltro) {
+        int prosp = prospeccao(p);
+        List<Achado> lista = new ArrayList<>();
+        for (Map.Entry<Integer, List<Spot>> en : vivos.entrySet()) {
+            Monster m = World.world.getMonstre(en.getKey());
+            if (m == null || m.getDrops() == null) continue;
+            Map<Integer, int[]> porSa = new HashMap<>();   // sa -> {qtd, mapa, x, y, melhorQtd, nivel}
+            for (Spot s : en.getValue()) {
+                if (saFiltro >= 0 && s.sa != saFiltro) continue;
+                int[] t = porSa.computeIfAbsent(s.sa, k -> new int[]{0, s.mapa, s.x, s.y, 0, s.nivel});
+                t[0] += s.qtd;
+                if (s.qtd > t[4]) {
+                    t[1] = s.mapa;
+                    t[2] = s.x;
+                    t[3] = s.y;
+                    t[4] = s.qtd;
+                }
+            }
+            if (porSa.isEmpty()) continue;
+            for (World.Drop d : m.getDrops()) {
+                ObjectTemplate t = World.world.getObjTemplate(d.getObjectId());
+                if (t == null || d.getAction() != -1 || (d.getCondition() != null && !d.getCondition().isEmpty())) continue;
+                if (!TIPOS_BONS.contains(t.getType()) && t.getPanoId() <= 0) continue;
+                boolean dofus = t.getType() == Constant.ITEM_TYPE_DOFUS;
+                for (Map.Entry<Integer, int[]> z : porSa.entrySet()) {
+                    int[] info = z.getValue();
+                    if (!dofus && Math.abs(info[5] - p.getLevel()) > 40 && saFiltro < 0) continue;
+                    if (!dofus && Math.abs(t.getLevel() - p.getLevel()) > 45 && saFiltro < 0) continue;
+                    Achado a = new Achado();
+                    a.mob = en.getKey();
+                    a.item = t.getId();
+                    a.qtd = info[0];
+                    a.mapa = info[1];
+                    a.x = info[2];
+                    a.y = info[3];
+                    a.sa = z.getKey();
+                    a.chance = chance(maxPercent(d), prosp);
+                    if (a.chance >= 0.01) lista.add(a);
+                }
+            }
+        }
+        if (lista.isEmpty()) return null;
+        lista.sort((a, b) -> Integer.compare(b.qtd, a.qtd));
+        return lista.get(ThreadLocalRandom.current().nextInt(Math.min(12, lista.size())));
+    }
+
+    private boolean oportunidade(Player p, Estado e) {
+        Achado a = achado(p, -1);
+        if (a == null) return false;
+        ObjectTemplate t = World.world.getObjTemplate(a.item);
+        Map<String, String> v = vars(p);
+        v.put("mob", nomeMob(a.mob));
+        v.put("qtd", String.valueOf(a.qtd));
+        v.put("zona", nomeSa(a.sa));
+        v.put("x", String.valueOf(a.x));
+        v.put("y", String.valueOf(a.y));
+        v.put("item", "\u00b00");
+        v.put("chance", fmt(a.chance));
+        v.put("mapa", String.valueOf(a.mapa));
+        e.ultimoMapa = a.mapa;
+        return modelo(p, e, ITENS, t.getType() == Constant.ITEM_TYPE_DOFUS ? "drop_dofus" : "drop_aqui", v, Collections.singletonList(a.item));
+    }
+
+    private boolean fm(Player p, Estado e, String arg) {
+        ObjectTemplate t = null;
+        if (arg != null && !arg.isEmpty()) {
+            try {
+                t = World.world.getObjTemplate(Integer.parseInt(arg.replaceAll("[^0-9]", "")));
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        if (t == null) {
+            List<ObjectTemplate> meus = new ArrayList<>();
+            for (int pos : POS_EQUIP) {
+                GameObject o = p.getObjetByPos(pos);
+                if (o != null && o.getTemplate() != null && JobAction.getStatBaseMaxs(o.getTemplate(), "6f") <= 0) meus.add(o.getTemplate());
+            }
+            t = meus.isEmpty() || ThreadLocalRandom.current().nextInt(3) == 0 ? World.world.getObjTemplate(GELANO)
+                    : meus.get(ThreadLocalRandom.current().nextInt(meus.size()));
+        }
+        if (t == null) return false;
+        int[] pa = chanceFm(t, "6f", 100), pm = chanceFm(t, "80", 90);
+        if (pa == null || pm == null) return false;
+        Map<String, String> v = vars(p);
+        v.put("item", "\u00b00");
+        v.put("runa_pa", "\u00b01");
+        v.put("runa_pm", "\u00b02");
+        v.put("pa", String.valueOf(Math.min(100, pa[0] + pa[1])));
+        v.put("pa_sc", String.valueOf(pa[0]));
+        v.put("pm", String.valueOf(Math.min(100, pm[0] + pm[1])));
+        return modelo(p, e, ITENS, "fm", v, Arrays.asList(t.getId(), RUNA_PA, RUNA_PM));
+    }
+
+    /** Chance de forjamagia (sucesso cr\u00edtico, sucesso neutro) de +1 no efeito, com a mesma f\u00f3rmula do servidor. */
+    private int[] chanceFm(ObjectTemplate t, String stat, int peso) {
+        int chave = t.getId() * 1000 + Integer.parseInt(stat, 16);
+        int[] cache = cacheFm.get(chave);
+        if (cache != null) return cache;
+        try {
+            GameObject obj = t.createNewItem(1, false);
+            String s = obj.encodeStats();
+            int pesoTotal = s.isEmpty() ? 1 : JobAction.currentTotalWeigthBase(s, obj);
+            int pesoStat = s.isEmpty() ? 1 : JobAction.currentWeithStats(obj, stat);
+            int base = Math.max(0, JobAction.WeithTotalBase(t.getId())), baseMin = JobAction.WeithTotalBaseMin(t.getId());
+            int max = JobAction.getStatBaseMaxs(t, stat), min = JobAction.getStatBaseMins(t, stat), atual = JobAction.currentStats(obj, stat);
+            float coef = max > 0 ? 1.0f : JobAction.coefExo;
+            int diff = (int) Math.abs(base * 1.3f - Math.max(0, pesoTotal));
+            ArrayList<Integer> c = Formulas.chanceFM(base, baseMin, Math.max(1, pesoTotal), Math.max(0, pesoStat), peso, diff, coef, max, min, atual, 1f, false, 1);
+            int[] r = {c.get(0), c.get(1)};
+            cacheFm.put(chave, r);
+            return r;
+        } catch (Exception ex) {
+            return null;
+        }
+    }
+
+    // ================================================================== chefes, raros, procurados, segredos, calabou\u00e7os
+    private boolean chefe(Player p, Estado e, Integer forcado) {
+        Chefe c = forcado != null ? chefes.get(forcado) : null;
+        if (c == null) {
+            List<Chefe> bons = new ArrayList<>();
+            for (Chefe x : chefes.values())
+                if (x.min <= p.getLevel() + 15 && x.max >= p.getLevel() - 25) bons.add(x);
+            if (bons.isEmpty()) bons.addAll(chefes.values());
+            bons.removeIf(x -> e.recentes.contains("chefe" + x.id));
+            if (bons.isEmpty()) return false;
+            c = bons.get(ThreadLocalRandom.current().nextInt(bons.size()));
+        }
+        lembrar(e, "chefe" + c.id);
+        Map<String, String> v = vars(p);
+        v.put("mob", nomeMob(c.id));
+        v.put("ficha", c.ficha);
+        v.put("dica", c.dica);
+        modelo(p, e, CHEFES, "chefe_ficha", v, null);
+        modelo(p, e, CHEFES, "chefe_dica", v, null);
+        // drops raros com a chance do jogador
+        Monster m = World.world.getMonstre(c.id);
+        if (m != null && m.getDrops() != null) {
+            int prosp = prospeccao(p);
+            List<Object[]> ds = new ArrayList<>();
+            for (World.Drop d : m.getDrops()) {
+                ObjectTemplate t = World.world.getObjTemplate(d.getObjectId());
+                if (t == null || d.getAction() != -1) continue;
+                if (!TIPOS_BONS.contains(t.getType()) && t.getPanoId() <= 0 && maxPercent(d) > 5) continue;
+                double ch = chance(maxPercent(d), prosp);
+                if (ch >= 0.01) ds.add(new Object[]{t.getId(), ch});
+            }
+            ds.sort((a, b) -> Double.compare((Double) a[1], (Double) b[1]));
+            if (!ds.isEmpty()) {
+                List<Integer> ids = new ArrayList<>();
+                StringBuilder txt = new StringBuilder();
+                for (Object[] d : ds.subList(0, Math.min(4, ds.size()))) {
+                    if (txt.length() > 0) txt.append(", ");
+                    txt.append("\u00b0").append(ids.size()).append(" (").append(fmt((Double) d[1])).append("%)");
+                    ids.add((Integer) d[0]);
+                }
+                v.put("drops", txt.toString());
+                modelo(p, e, CHEFES, "chefe_drop", v, ids);
+            }
+        }
+        Spot s = primeiroVivo(c.id);
+        if (s != null) {
+            v.put("zona", nomeSa(s.sa));
+            v.put("x", String.valueOf(s.x));
+            v.put("y", String.valueOf(s.y));
+            v.put("mapa", String.valueOf(s.mapa));
+            e.ultimoMapa = s.mapa;
+            modelo(p, e, CHEFES, "chefe_onde", v, null);
+        }
+        return true;
+    }
