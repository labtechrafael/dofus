+    private void ir(Player p, String arg, Estado e) {
+        if (p.getGroup() == null) {
+            p.sendMessage("S\u00f3 GMs podem usar .ir.");
+            return;
+        }
+        if (p.getFight() != null) {
+            p.sendMessage("Termine a luta antes.");
+            return;
+        }
+        int mapa = e.ultimoMapa;
+        if (!arg.isEmpty()) {
+            try {
+                mapa = Integer.parseInt(arg.replaceAll("[^0-9]", ""));
+            } catch (NumberFormatException ex) {
+                mapa = -1;
+            }
+        }
+        GameMap map = mapa > 0 ? World.world.getMap(mapa) : null;
+        if (map == null) {
+            p.sendMessage(mapa > 0 ? "Esse mapa n\u00e3o existe neste servidor." : "Digite .ir seguido do n\u00famero do mapa.");
+            return;
+        }
+        int cell = map.getRandomFreeCellId();
+        if (cell <= 0 || map.getCase(cell) == null) {
+            p.sendMessage("N\u00e3o achei uma casa livre nesse mapa.");
+            return;
+        }
+        p.teleport(mapa, cell);
+    }
