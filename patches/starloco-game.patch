+    private Spot spotNaZona(int sa) {
+        Spot melhor = null;
+        for (List<Spot> l : vivos.values())
+            for (Spot s : l)
+                if (s.sa == sa && (melhor == null || s.qtd > melhor.qtd)) melhor = s;
+        return melhor;
+    }
