+    private Set<String> feitos(Player p) {
+        lerProgresso();
+        return progresso.computeIfAbsent(p.getId(), k -> ConcurrentHashMap.newKeySet());
+    }
+
+    private synchronized void lerProgresso() {
+        if (progressoLido) return;
+        progressoLido = true;
+        try {
+            if (!Files.exists(PROGRESSO)) return;
+            for (String linha : Files.readAllLines(PROGRESSO, StandardCharsets.UTF_8)) {
+                String[] c = linha.split("\t");
+                if (c.length < 2) continue;
+                Set<String> s = ConcurrentHashMap.newKeySet();
+                s.addAll(Arrays.asList(c[1].split(",")));
+                progresso.put(Integer.parseInt(c[0]), s);
+            }
+        } catch (Exception ex) {
+            Main.logger.error("Chat vivo: progresso dos calabou\u00e7os", ex);
+        }
+    }
+
+    private synchronized void salvarProgresso() {
+        try {
+            List<String> linhas = new ArrayList<>();
+            for (Map.Entry<Integer, Set<String>> en : progresso.entrySet())
+                linhas.add(en.getKey() + "\t" + String.join(",", en.getValue()));
+            Files.write(PROGRESSO, linhas, StandardCharsets.UTF_8);
+        } catch (Exception ex) {
+            Main.logger.error("Chat vivo: salvar progresso", ex);
+        }
+    }
