+    // ================================================================== comandos do chat
+    /** Comandos do chat vivo. @return true se o comando era dele. */
+    public static boolean comando(Player p, String msg) {
+        if (msg == null || msg.length() < 2 || msg.charAt(0) != '.') return false;
+        String[] partes = msg.substring(1).trim().split("\\s+", 2);
+        String cmd = partes[0].toLowerCase(), arg = partes.length > 1 ? partes[1].trim() : "";
+        ChatVivo cv = instance;
+        cv.carregar();
+        Estado e = cv.estado(p);
+        switch (cmd) {
+            case "dica": if (!cv.dica(p, e)) cv.frase(p, e, cv.dicas.get("geral"), DICAS); return true;
+            case "build": cv.build(p, e); return true;
+            case "conjunto": cv.conjunto(p, e); return true;
+            case "drop": if (!cv.oportunidade(p, e)) p.sendMessage("Nenhum monstro com drop interessante perto do seu n\u00edvel agora."); return true;
+            case "fm": cv.fm(p, e, arg); return true;
+            case "chefe": cv.chefe(p, e, null); return true;
+            case "procurado": case "procurados": cv.procurado(p, e); return true;
+            case "raro": case "raros": if (!cv.raro(p, e)) p.sendMessage("Nenhum monstro raro no mundo agora. Fique de olho."); return true;
+            case "segredo": case "segredos": cv.local(p, e); return true;
+            case "curiosidade": cv.frase(p, e, cv.curiosidades, DICAS); return true;
+            case "calaboucos": case "calabou\u00e7os": case "rota": cv.rota(p); return true;
+            case "evento": cv.eventoInfo(p); return true;
+            case "ir": cv.ir(p, arg, e); return true;
+            case "chatvivo":
+                if (arg.startsWith("desl") || arg.startsWith("off")) {
+                    e.desligado = true;
+                    p.sendMessage("Chat vivo desligado. Use .chatvivo liga para voltar.");
+                } else {
+                    e.desligado = false;
+                    e.saudado = false;
+                    e.entrouEm = System.currentTimeMillis() - 11_000;
+                    p.sendMessage("Chat vivo ligado.");
+                }
+                return true;
+            default: return false;
+        }
+    }
