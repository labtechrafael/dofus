+    // ================================================================== varredura do mundo
+    private void varrer() {
+        Map<Integer, List<Spot>> novo = new HashMap<>();
+        try {
+            for (GameMap map : new ArrayList<>(World.world.getMaps())) {
+                Map<Integer, MonsterGroup> gs = map.getMobGroups();
+                if (gs == null || gs.isEmpty()) continue;
+                SubArea sa = map.getSubArea();
+                int said = sa != null ? sa.getId() : -1;
+                for (MonsterGroup g : new ArrayList<>(gs.values())) {
+                    Map<Integer, int[]> cont = new HashMap<>();
+                    for (MonsterGrade m : new ArrayList<>(g.getMobs().values())) {
+                        if (m == null || m.getTemplate() == null) continue;
+                        int[] c = cont.computeIfAbsent(m.getTemplate().getId(), k -> new int[2]);
+                        c[0]++;
+                        c[1] = Math.max(c[1], m.getLevel());
+                    }
+                    for (Map.Entry<Integer, int[]> en : cont.entrySet()) {
+                        Spot s = new Spot();
+                        s.mapa = map.getId();
+                        s.grupo = g.getId();
+                        s.qtd = en.getValue()[0];
+                        s.nivel = en.getValue()[1];
+                        s.sa = said;
+                        s.x = map.getX();
+                        s.y = map.getY();
+                        novo.computeIfAbsent(en.getKey(), k -> new ArrayList<>()).add(s);
+                    }
+                }
+            }
+        } catch (Exception ex) {
+            Main.logger.error("Chat vivo: varredura", ex);
+            return;
+        }
+        vivos = novo;
+        // raros e procurados que acabaram de aparecer: todo mundo fica sabendo
+        Set<String> atuais = new HashSet<>();
+        for (int id : raros) anunciarAparicao(id, novo, atuais, "raro");
+        for (int id : procurados.keySet()) anunciarAparicao(id, novo, atuais, "procurado");
+        anunciados.retainAll(atuais);
+        primeiraVarredura = false;
+    }
+
+    private void anunciarAparicao(int id, Map<Integer, List<Spot>> novo, Set<String> atuais, String tipo) {
+        List<Spot> l = novo.get(id);
+        if (l == null) return;
+        for (Spot s : l) {
+            String chave = id + ":" + s.mapa + ":" + s.grupo;
+            atuais.add(chave);
+            if (!anunciados.add(chave) || primeiraVarredura) continue;
+            for (Player p : new ArrayList<>(World.world.getOnlinePlayers())) {
+                if (p == null || !p.isOnline()) continue;
+                Estado e = estado(p);
+                if (!e.desligado) anunciarRaro(p, e, id, s, tipo);
+            }
+        }
+    }
+
+    private Spot primeiroVivo(int mob) {
+        List<Spot> l = vivos.get(mob);
+        return l == null || l.isEmpty() ? null : l.get(0);
