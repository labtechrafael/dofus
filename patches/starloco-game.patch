+    // ================================================================== utilit\u00e1rios
+    private static List<Player> jogadores(Fight fight) {
+        List<Player> out = new ArrayList<>();
+        for (Fighter f : fight.getFighters(3)) {
+            Player p = f.getPlayer();
+            if (p != null && f.getId() == p.getId() && p.isOnline() && !out.contains(p)) out.add(p);
+        }
+        return out;
+    }
+
+    private int prospeccao(Player p) {
+        int pr = p.getTotalStats(false).getEffect(Constant.STATS_ADD_PROS);
+        return Math.max(100, pr);
+    }
+
+    private double chance(double percent, int prosp) {
+        return Math.min(100.0, percent * Math.max(1.0, prosp / 100.0) * Config.rateDrop);
+    }
+
+    private double maxPercent(World.Drop d) {
+        double m = 0;
+        for (int g = 1; g <= 5; g++) {
+            World.Drop c = d.copy(g);
+            if (c != null) m = Math.max(m, c.getLocalPercent());
+        }
+        return m;
+    }
+
+    private String faixaMonstro(Monster m) {
+        int min = Integer.MAX_VALUE, max = 0;
+        for (MonsterGrade g : m.getGrades().values()) {
+            min = Math.min(min, g.getLevel());
+            max = Math.max(max, g.getLevel());
+        }
+        return min == max ? String.valueOf(min) : min + "\u2013" + max;
+    }
+
+    private static String fmt(double v) {
+        if (v >= 10) return String.valueOf(Math.round(v));
+        String s = String.format(Locale.ROOT, v >= 1 ? "%.1f" : "%.2f", v);
+        if (s.contains(".")) s = s.replaceAll("0+$", "").replaceAll("\\.$", "");
+        return s.replace('.', ',');
+    }
+
+    private String nomeMob(int id) {
+        String n = nomeMob.get(id);
+        return n != null ? n : "Monstro";
+    }
+
+    private String nomeSa(int sa) {
+        String n = nomeSa.get(sa);
+        return n != null ? n : "algum lugar";
+    }
+
+    private static String marcadores(int de, int n) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = de; i < de + n; i++) sb.append(i > de ? " " : "").append("\u00b0").append(i);
+        return sb.toString();
+    }
+
+    private Map<String, String> vars(Player p) {
+        Map<String, String> v = new HashMap<>();
+        v.put("nome", p.getName());
+        v.put("nivel", String.valueOf(p.getLevel()));
+        v.put("capital", String.valueOf(p.getCapital()));
+        v.put("pontos", String.valueOf(p.get_spellPts()));
+        v.put("vida", String.valueOf(p.getMaxPdv() > 0 ? p.getCurPdv() * 100 / p.getMaxPdv() : 100));
+        v.put("energia", String.valueOf(p.getEnergy()));
+        v.put("xp", String.valueOf(Config.rateXp));
+        v.put("drop", String.valueOf(Config.rateDrop));
+        v.put("prosp", String.valueOf(prospeccao(p)));
+        return v;
+    }
+
+    private String preencher(String texto, Map<String, String> v) {
+        if (texto == null) return "";
+        String t = texto;
+        if (t.contains("{como_ir}")) {
+            String mapa = v.get("mapa");
+            List<Frase> ci = modelos.get("como_ir");
+            t = t.replace("{como_ir}", mapa == null || mapa.isEmpty() || ci == null || ci.isEmpty() ? "" : ci.get(0).texto);
+        }
+        for (Map.Entry<String, String> e : v.entrySet())
+            t = t.replace("{" + e.getKey() + "}", e.getValue() == null ? "" : e.getValue());
+        return t.trim();
+    }
+
+    private boolean modelo(Player p, Estado e, String canal, String tipo, Map<String, String> v, List<Integer> itens) {
+        Frase f = sorteia(modelos.get(tipo), e);
+        if (f == null) return false;
+        falar(p, canal, preencher(f.quem, v), preencher(f.texto, v), itens);
+        return true;
+    }
+
+    private Frase sorteia(List<Frase> lista, Estado e) {
+        if (lista == null || lista.isEmpty()) return null;
+        Frase f = null;
+        for (int i = 0; i < 6; i++) {
+            f = lista.get(ThreadLocalRandom.current().nextInt(lista.size()));
+            if (!e.recentes.contains(f.texto)) break;
+        }
+        lembrar(e, f.texto);
+        return f;
+    }
+
+    private void lembrar(Estado e, String chave) {
+        e.recentes.addLast(chave);
+        while (e.recentes.size() > 30) e.recentes.removeFirst();
+    }
+
+    private static String limpar(String s) {
+        return s.replace('|', '/').replace("\n", " ");
+    }
+
+    /** Uma mensagem no canal, dita por "quem"; itens viram links clic\u00e1veis nos marcadores \u00b00, \u00b01... */
+    private void falar(Player p, String canal, String quem, String texto, List<Integer> itens) {
+        if (texto == null || texto.isEmpty()) return;
+        StringBuilder its = new StringBuilder();
+        if (itens != null)
+            for (int id : itens) {
+                ObjectTemplate t = World.world.getObjTemplate(id);
+                if (t == null) continue;
+                if (its.length() > 0) its.append('!');
+                its.append(id).append('!').append(t.getStrTemplate() == null ? "" : t.getStrTemplate());
+            }
+        String nome = quem == null || quem.isEmpty() ? "LabTech" : limpar(quem);
+        SocketManager.send(p, "cMK" + canal + "|0|" + nome + "|" + limpar(texto) + "|" + its);
+    }
+
+    // ================================================================== leitura do TSV
+    private synchronized void carregar() {
+        long mod = -3;
+        try {
+            if (!Files.exists(ARQUIVO)) return;
+            mod = Files.getLastModifiedTime(ARQUIVO).toMillis();
+            if (mod == lidoEm) return;
+            dicas.clear(); modelos.clear(); eventosTxt.clear(); dicasNivel.clear(); dicasNivelFaixa.clear();
+            curiosidades.clear(); segredos.clear(); boasVindas.clear(); builds.clear(); conjuntos.clear(); zonas.clear();
+            chefes.clear(); nomeMob.clear(); nomeSa.clear(); mobZonas.clear(); procurados.clear(); raros.clear();
+            locais.clear(); calaboucos.clear();
+            for (String linha : Files.readAllLines(ARQUIVO, StandardCharsets.UTF_8)) {
+                if (linha.isEmpty() || linha.startsWith("#")) continue;
+                String[] c = linha.split("\t", -1);
+                try {
+                    switch (c[0]) {
+                        case "config":
+                            if (c[1].equals("intervalo")) {
+                                String[] mm = c[2].split("-");
+                                minSeg = Integer.parseInt(mm[0]);
+                                maxSeg = Math.max(minSeg, Integer.parseInt(mm[1]));
+                            }
+                            break;
+                        case "dica": dicas.computeIfAbsent(c[1], k -> new ArrayList<>()).add(new Frase(c[2], c[3])); break;
+                        case "dica_nivel": {
+                            String[] ab = c[1].split("-");
+                            dicasNivelFaixa.add(new int[]{Integer.parseInt(ab[0]), Integer.parseInt(ab[1])});
+                            dicasNivel.add(new Frase(c[2], c[3]));
+                            break;
+                        }
+                        case "curiosidade": curiosidades.add(new Frase(c[2], c[3])); break;
+                        case "segredo": segredos.add(new Frase(c[2], c[3])); break;
+                        case "boas_vindas": boasVindas.add(new Frase(c[2], c[3])); break;
+                        case "modelo": modelos.computeIfAbsent(c[1], k -> new ArrayList<>()).add(new Frase(c[2], c[3])); break;
+                        case "evento": eventosTxt.computeIfAbsent(c[1], k -> new ArrayList<>()).add(new Frase(c[2], c[3])); break;
+                        case "build": {
+                            List<int[]> pares = new ArrayList<>();
+                            for (String par : c[2].split(";")) {
+                                String[] pv = par.split("=");
+                                pares.add(new int[]{Integer.parseInt(pv[0]), Integer.parseInt(pv[1])});
+                            }
+                            builds.put(c[1], pares.toArray(new int[0][]));
+                            break;
+                        }
+                        case "conjunto": {
+                            Conjunto k = new Conjunto();
+                            k.nivel = Integer.parseInt(c[2]);
+                            k.notas = Arrays.stream(c[3].split(",")).mapToInt(Integer::parseInt).toArray();
+                            k.nome = c[4];
+                            k.ids = Arrays.stream(c[5].split(",")).mapToInt(Integer::parseInt).toArray();
+                            k.resumo = c.length > 6 ? c[6] : "";
+                            conjuntos.add(k);
+                            break;
+                        }
+                        case "zona": {
+                            Zona z = new Zona();
+                            z.min = Integer.parseInt(c[2]);
+                            z.max = Integer.parseInt(c[3]);
+                            z.nome = c[4];
+                            z.mobs = c[5];
+                            zonas.put(Integer.parseInt(c[1]), z);
+                            break;
+                        }
+                        case "chefe": {
+                            Chefe k = new Chefe();
+                            k.id = Integer.parseInt(c[1]);
+                            k.min = Integer.parseInt(c[2]);
+                            k.max = Integer.parseInt(c[3]);
+                            k.ficha = c[4];
+                            k.dica = c[5];
+                            chefes.put(k.id, k);
+                            break;
+                        }
+                        case "nome_mob": nomeMob.put(Integer.parseInt(c[1]), c[2]); break;
+                        case "nome_sa": nomeSa.put(Integer.parseInt(c[1]), c[2]); break;
+                        case "mob_zona": mobZonas.put(Integer.parseInt(c[1]), Arrays.stream(c[2].split(",")).mapToInt(Integer::parseInt).toArray()); break;
+                        case "raro": raros.add(Integer.parseInt(c[1])); break;
+                        case "procurado": {
+                            int[] sas = c.length > 2 && !c[2].isEmpty()
+                                    ? Arrays.stream(c[2].split(",")).filter(x -> !x.trim().isEmpty()).mapToInt(x -> Integer.parseInt(x.trim())).toArray() : new int[0];
+                            procurados.put(Integer.parseInt(c[1]), sas);
+                            break;
+                        }
+                        case "local_secreto": {
+                            Local l = new Local();
+                            l.mapa = Integer.parseInt(c[1]);
+                            l.nome = c[2];
+                            l.xy = c[3];
+                            l.nota = c[4];
+                            locais.add(l);
+                            break;
+                        }
+                        case "calabouco": {
+                            Calabouco k = new Calabouco();
+                            k.chave = c[1];
+                            k.nome = c[2];
+                            k.chefe = Integer.parseInt(c[3]);
+                            String[] fx = c[4].split("-");
+                            k.min = Integer.parseInt(fx[0]);
+                            k.max = Integer.parseInt(fx[1]);
+                            k.primeira = Integer.parseInt(c[5]);
+                            for (String s : c[6].split(",")) k.salas.add(Integer.parseInt(s));
+                            calaboucos.add(k);
+                            break;
+                        }
+                        case "estatistica": estatistica = c[2].split("\\|"); break;
+                        default:
+                    }
+                } catch (Exception linhaRuim) {
+                    // linha que n\u00e3o bate com o formato: ignora e segue
+                }
+            }
+            lidoEm = mod;
+            Main.logger.info("Chat vivo: " + modelos.size() + " modelos, " + chefes.size() + " chefes, " + zonas.size() + " zonas carregados");
+        } catch (Exception ex) {
+            Main.logger.error("Chat vivo: falha ao ler " + ARQUIVO, ex);
+            lidoEm = mod;
+        }
+    }
+}
