+    // ================================================================== dicas
+    private boolean dica(Player p, Estado e) {
+        long agora = System.currentTimeMillis();
+        Map<String, String> v = vars(p);
+        List<String> ativas = new ArrayList<>();
+        List<Integer> itemDaRegra = new ArrayList<>();
+        if (p.getCapital() > 0) ativas.add("capital");
+        if (p.get_spellPts() > 0 && p.getClasse() != Constant.CLASS_LABTECH) ativas.add("feitico");
+        int[][] b = buildDe(p);
+        for (int pos : POS_EQUIP) {
+            GameObject o = p.getObjetByPos(pos);
+            int sugestao = b == null ? -1 : itemDoSlot(b, pos);
+            if (o == null && sugestao > 0 && podeUsarRegra(e, "slot" + pos, agora)) {
+                ativas.add("slot");
+                v.put("slot", NOME_POS[pos]);
+                itemDaRegra.add(sugestao);
+                break;
+            }
+            if (o != null && sugestao > 0 && o.getTemplate().getLevel() < p.getLevel() - 30
+                    && World.world.getObjTemplate(sugestao).getLevel() > o.getTemplate().getLevel() + 15 && podeUsarRegra(e, "upg" + pos, agora)) {
+                ativas.add("upgrade");
+                v.put("slot", NOME_POS[pos]);
+                v.put("nivel_item", String.valueOf(o.getTemplate().getLevel()));
+                itemDaRegra.add(sugestao);
+                break;
+            }
+        }
+        if (p.getMetiers().isEmpty()) ativas.add("profissao");
+        if (p.getAlignment() == Constant.ALIGNEMENT_NEUTRE && p.getLevel() >= 10) ativas.add("alinhamento");
+        if (p.getLevel() >= 60 && p.getMount() == null) ativas.add("montaria");
+        if (p.getLevel() >= 95 && p.getLevel() < 100) ativas.add("nivel100");
+        if (p.getMaxPdv() > 0 && p.getCurPdv() * 100 / p.getMaxPdv() < 50) ativas.add("vida");
+        if (p.getEnergy() < 3000) ativas.add("energia");
+        ativas.removeIf(r -> !r.equals("slot") && !r.equals("upgrade") && !podeUsarRegra(e, r, agora));
+        String regra;
+        if (!ativas.isEmpty()) {
+            regra = ativas.get(ThreadLocalRandom.current().nextInt(ativas.size()));
+        } else {
+            String[] extras = {"onde_upar", "chefe_nivel", "rates", "geral", "geral", "nivel"};
+            regra = extras[ThreadLocalRandom.current().nextInt(extras.length)];
+            if (!podeUsarRegra(e, regra, agora) && !regra.equals("geral")) regra = "geral";
+        }
+        e.regras.put(regra, agora);
+        if (regra.startsWith("slot") || regra.equals("upgrade")) e.regras.put(regra.equals("slot") ? "slot" : "upgrade", agora);
+        switch (regra) {
+            case "onde_upar": {
+                Zona z = zonaPara(p.getLevel());
+                if (z == null) return frase(p, e, dicas.get("geral"), DICAS);
+                int sa = zonaId(z);
+                v.put("zona", z.nome);
+                v.put("faixa", z.min + "\u2013" + z.max);
+                v.put("mobs", z.mobs);
+                Spot s = spotNaZona(sa);
+                v.put("mapa", s != null ? String.valueOf(s.mapa) : "");
+                if (s != null) e.ultimoMapa = s.mapa;
+                break;
+            }
+            case "chefe_nivel": {
+                List<String> nomes = new ArrayList<>();
+                for (Chefe c : chefes.values())
+                    if (c.min <= p.getLevel() + 15 && c.max >= p.getLevel() - 20) nomes.add(nomeMob(c.id) + " (" + c.min + ")");
+                if (nomes.isEmpty()) return frase(p, e, dicas.get("geral"), DICAS);
+                Collections.shuffle(nomes);
+                v.put("chefes", String.join(", ", nomes.subList(0, Math.min(5, nomes.size()))));
+                break;
+            }
+            case "nivel": {
+                List<Frase> l = new ArrayList<>();
+                for (int i = 0; i < dicasNivel.size(); i++) {
+                    int[] f = dicasNivelFaixa.get(i);
+                    if (p.getLevel() >= f[0] && p.getLevel() < f[1]) l.add(dicasNivel.get(i));
+                }
+                return frase(p, e, l, DICAS);
+            }
+            default:
+        }
+        List<Frase> lista = dicas.get(regra);
+        Frase f = sorteia(lista, e);
+        if (f == null) return false;
+        String texto = preencher(f.texto, v);
+        falar(p, DICAS, preencher(f.quem, v), texto, itemDaRegra);
+        return true;
+    }
+
+    private boolean podeUsarRegra(Estado e, String regra, long agora) {
+        Long t = e.regras.get(regra);
+        return t == null || agora - t > 10 * 60_000;
+    }
+
+    private boolean frase(Player p, Estado e, List<Frase> lista, String canal) {
+        Frase f = sorteia(lista, e);
+        if (f == null) return false;
+        Map<String, String> v = vars(p);
+        v.put("monstros", estatistica[0]);
+        v.put("itens", estatistica[1]);
+        v.put("conjuntos", estatistica[2]);
+        v.put("chefes", estatistica[3]);
+        falar(p, canal, preencher(f.quem, v), preencher(f.texto, v), null);
+        return true;
+    }
