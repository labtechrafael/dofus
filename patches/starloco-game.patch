+import java.util.List;
+
+/**
+ * Local admin panel bridge.
+ * Polls `panel_commands` (login database) and runs each pending command on the target
+ * player once that player is online. Runs on the main loop thread, like the other Updatables.
+ */
+public class PanelBridge extends Updatable<Void> {
+
+    public final static PanelBridge instance = new PanelBridge(1000);
+
+    private Connection connection;
+    private boolean staleCleared = false;
+
+    public PanelBridge(int wait) {
+        super(wait);
+    }
+
+    private Connection connection() throws SQLException {
+        if (connection == null || !connection.isValid(2)) {
+            String url = "jdbc:mysql://" + Config.databaseLoginHost + ":" + Config.databaseLoginPort + "/"
+                    + Config.databaseLoginName + "?useSSL=false&useUnicode=true&characterEncoding=UTF-8";
+            connection = DriverManager.getConnection(url, Config.databaseLoginUser, Config.databaseLoginPass);
+            try (Statement st = connection.createStatement()) {
+                st.execute("CREATE TABLE IF NOT EXISTS panel_commands (" +
+                        "id INT AUTO_INCREMENT PRIMARY KEY, player VARCHAR(30) NOT NULL, command TEXT NOT NULL, " +
+                        "status VARCHAR(16) NOT NULL DEFAULT 'pending', result TEXT, " +
+                        "created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, done_at TIMESTAMP NULL)");
+                if (!staleCleared) {
+                    // Comandos de servidor (SAVE/STOP) que sobraram de antes deste servidor ligar nao valem mais:
+                    // um STOP antigo derrubaria o servidor logo depois de iniciar.
+                    st.execute("UPDATE panel_commands SET status = 'expired', result = 'servidor reiniciado antes', " +
+                            "done_at = NOW() WHERE player = '*' AND status = 'pending'");
+                    staleCleared = true;
+                }
+            }
+        }
+        return connection;
+    }
+
+    @Override
+    public void update() {
+        if (!this.verify()) return;
+        try {
+            List<Object[]> pending = new ArrayList<>();
+            try (Statement st = connection().createStatement();
+                 ResultSet rs = st.executeQuery("SELECT id, player, command FROM panel_commands WHERE status = 'pending' ORDER BY id LIMIT 50")) {
+                while (rs.next()) pending.add(new Object[]{rs.getInt(1), rs.getString(2), rs.getString(3)});
+            }
+            for (Object[] row : pending) {
+                boolean server = "*".equals(row[1]);
+                Player player = server ? null : World.world.getPlayerByName((String) row[1]);
+                if (!server && (player == null || !player.isOnline() || player.getGameClient() == null)) continue; // wait until online
+
+                String status = "done", result;
+                try {
+                    result = server ? executeServer(((String) row[2]).trim()) : execute(player, ((String) row[2]).trim());
+                } catch (Exception e) {
+                    status = "error";
+                    result = e.getClass().getSimpleName() + ": " + e.getMessage();
+                    Main.logger.error("Panel command failed: {}", row[2], e);
+                }
+                try (PreparedStatement ps = connection().prepareStatement(
+                        "UPDATE panel_commands SET status = ?, result = ?, done_at = NOW() WHERE id = ?")) {
+                    ps.setString(1, status);
+                    ps.setString(2, result);
+                    ps.setInt(3, (Integer) row[0]);
+                    ps.executeUpdate();
+                }
+            }
+        } catch (SQLException e) {
+            Main.logger.error("PanelBridge database error: {}", e.getMessage());
+            connection = null;
+        }
+    }
+
+    /** Server-wide commands, queued with player '*'. */
+    private String executeServer(String msg) {
+        switch (msg.toUpperCase()) {
+            case "SAVE":
+                WorldSave.cast(0);
+                return "saved";
+            case "STOP":
+                Main.runnables.add(() -> Main.stop("Stopped from panel"));
+                return "stopping";
+            default:
+                return "unknown server command";
+        }
+    }
+
+    private String execute(Player player, String msg) {
+        String[] infos = msg.split(" ");
+        String command = infos[0].toUpperCase();
+
+        switch (command) {
+            case "PITEM": { // PITEM templateId qty MAX|RAND [stats]
+                ObjectTemplate template = World.world.getObjTemplate(Integer.parseInt(infos[1]));
+                if (template == null) return "template not found";
+                int quantity = Math.max(1, Integer.parseInt(infos[2]));
+                GameObject object = template.createNewItem(quantity, infos.length > 3 && infos[3].equalsIgnoreCase("MAX"));
+                if (infos.length > 4) { object.clearStats(); object.parseStringToStats(infos[4]); }
+                if (player.addItem(object, infos.length <= 4, true)) World.world.addGameObject(object);
+                DatabaseManager.get(PlayerData.class).update(player);
+                return "guid=" + object.getGuid();
+            }
+            case "PSETSTATS": { // PSETSTATS objectGuid stats
+                GameObject object = player.getItems().get(Integer.parseInt(infos[1]));
+                if (object == null) return "object not in inventory";
+                object.clearStats();
+                object.refreshStatsObjet(infos.length > 2 ? infos[2] : "");
+                SocketManager.GAME_SEND_UPDATE_ITEM(player, object);
+                SocketManager.GAME_SEND_STATS_PACKET(player);
+                return "ok";
+            }
+            case "PSPELLS": { // PSPELLS level id,id,id
+                int level = Math.min(6, Math.max(1, Integer.parseInt(infos[1])));
+                int learned = 0;
+                for (String id : infos[2].split(",")) {
+                    if (id.isEmpty() || World.world.getSort(Integer.parseInt(id)) == null) continue;
+                    if (player.learnSpell(Integer.parseInt(id), level, false, false, false)) learned++;
+                }
+                DatabaseManager.get(PlayerData.class).update(player);
+                SocketManager.GAME_SEND_SPELL_LIST(player);
+                return "learned=" + learned;
+            }
+            case "PMASTER": { // PMASTER ON|OFF - modo escravo: todos os personagens online seguem este lider
+                if (infos.length > 1 && infos[1].equalsIgnoreCase("OFF")) {
+                    Party party = player.getParty();
+                    if (party == null || party.getMaster() == null) return "not active";
+                    party.setMaster(null);
+                    for (Player member : party.getPlayers()) member.sendMessage("Modo escravo desligado.");
+                    return "off";
+                }
+                if (player.getFight() != null) return "leader is in a fight";
+                CommandPlayer.analyse(player, ".groupe"); // agrupa os personagens do mesmo IP que ainda nao tem grupo
+                Party party = player.getParty();
+                if (party == null) return "no other character online";
+                party.setChief(player);
+                party.setMaster(player);
+                for (Player member : party.getPlayers()) {
+                    member.send("PL" + player.getId());
+                    member.sendMessage(member == player
+                            ? "Modo escravo ligado: os outros personagens do grupo seguem voce."
+                            : "Modo escravo: voce segue " + player.getName() + ".");
+                }
+                return "leader=" + player.getName() + " members=" + party.getPlayers().size();
+            }
+            case "PBAR": { // PBAR <classe 1..12>: barra de feiticos com os feiticos daquela classe
+                int idx = Integer.parseInt(infos[1]) - 1;
+                if (idx < 0 || idx >= ClassSpellBar.SPELLS.length) return "invalid class";
+                return "placed=" + ClassSpellBar.apply(player, idx);
+            }
+            case "PPASS": { // PPASS - liga/desliga passar o turno automaticamente em luta (para um seguidor)
+                Party party = player.getParty();
+                if (party == null || party.getMaster() == null) return "master mode not active";
+                Party.MasterOption option = party.getOptionByPlayer(player);
+                if (option == null) return "no option";
+                option.togglePass();
+                return "autopass=" + option.passAuto();
+            }
+            default: // any existing admin command, run as the target player
+                new CommandAdmin(player).command(command, infos, msg);
+                DatabaseManager.get(PlayerData.class).update(player);
+                return "ok";
+        }
+    }
+
+    @Override
+    public Void get() {
+        return null;
+    }
+}
