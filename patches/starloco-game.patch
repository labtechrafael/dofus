+    // ================================================================== itens: build, conjunto, drop, forjamagia
+    private int elemento(Player p, Estado e) {
+        int melhor = -1, valor = 0;
+        for (int i = 0; i < 4; i++) {
+            int s = p.getStats().getEffect(STAT_ELEMENTO[i]);
+            if (s > valor) {
+                valor = s;
+                melhor = i;
+            }
+        }
+        if (melhor >= 0) return melhor;
+        switch (p.getClasse()) {
+            case Constant.CLASS_CRA: return 2;
+            case Constant.CLASS_ENUTROF: case Constant.CLASS_ECAFLIP: return 3;
+            case Constant.CLASS_FECA: case Constant.CLASS_OSAMODAS: case Constant.CLASS_ENIRIPSA: case Constant.CLASS_XELOR: return 1;
+            case Constant.CLASS_LABTECH: return e.rodada % 4;
+            default: return 0;
+        }
+    }
+
+    private int nivelBuild(int nivel) {
+        int n = nivel >= 10 ? (nivel / 10) * 10 : 1;
+        return Math.min(200, n);
+    }
+
+    private int[][] buildDe(Player p) {
+        Estado e = estado(p);
+        return builds.get(nivelBuild(p.getLevel()) + ":" + ELEMENTOS[elemento(p, e)]);
+    }
+
+    private int itemDoSlot(int[][] b, int pos) {
+        for (int[] par : b)
+            if (par[0] == pos) return par[1];
+        return -1;
+    }
+
+    private boolean build(Player p, Estado e) {
+        int el = elemento(p, e);
+        int nb = nivelBuild(p.getLevel());
+        int[][] b = builds.get(nb + ":" + ELEMENTOS[el]);
+        if (b == null) return false;
+        List<Integer> ids = new ArrayList<>();
+        for (int[] par : b) ids.add(par[1]);
+        Map<String, String> v = vars(p);
+        v.put("elemento", NOME_ELEMENTO[el]);
+        v.put("nivel_build", String.valueOf(nb));
+        v.put("itens", marcadores(0, ids.size()));
+        return modelo(p, e, ITENS, "build", v, ids);
+    }
+
+    private boolean conjunto(Player p, Estado e) {
+        int el = elemento(p, e);
+        List<Conjunto> bons = new ArrayList<>();
+        for (Conjunto c : conjuntos)
+            if (c.nivel <= p.getLevel() && c.nivel >= p.getLevel() - 35) bons.add(c);
+        if (bons.isEmpty()) return false;
+        bons.sort((a, b) -> b.notas[el] - a.notas[el]);
+        Conjunto c = bons.get(ThreadLocalRandom.current().nextInt(Math.min(3, bons.size())));
+        List<Integer> ids = new ArrayList<>();
+        for (int id : c.ids) ids.add(id);
+        Map<String, String> v = vars(p);
+        v.put("conjunto", c.nome);
+        v.put("nivel_item", String.valueOf(c.nivel));
+        v.put("resumo", c.resumo.isEmpty() ? "b\u00f4nus de conjunto" : c.resumo);
+        v.put("itens", marcadores(0, ids.size()));
+        return modelo(p, e, ITENS, "conjunto", v, ids);
+    }
