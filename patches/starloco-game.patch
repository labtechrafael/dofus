+    public static void onFightStart(Fight fight) {
+        try {
+            MonsterGrade chefe = null;
+            for (Fighter f : fight.getFighters(3)) {
+                MonsterGrade m = f.getMob();
+                if (m != null && !f.isInvocation() && instance.chefes.containsKey(m.getTemplate().getId())) chefe = m;
+            }
+            if (chefe == null) return;
+            for (Player p : jogadores(fight)) {
+                Estado e = instance.estados.get(p.getId());
+                if (e == null || e.desligado) continue;
+                instance.chefe(p, e, chefe.getTemplate().getId());
+            }
+        } catch (Exception ex) {
+            Main.logger.error("Chat vivo: inicio de luta", ex);
+        }
+    }
