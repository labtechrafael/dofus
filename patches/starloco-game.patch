+    private Calabouco proximoCalabouco(Player p) {
+        Set<String> feitos = feitos(p);
+        List<Calabouco> faltam = new ArrayList<>();
+        for (Calabouco c : calaboucos)
+            if (!feitos.contains(c.chave) && World.world.getMap(c.primeira) != null) faltam.add(c);
+        if (faltam.isEmpty()) return null;
+        faltam.sort(Comparator.comparingInt(c -> c.min));
+        Calabouco melhor = faltam.get(0);
+        for (Calabouco c : faltam)
