+    /** Abre a janela de compra do NPC (por id de template) que esta no mapa do jogador, como o botao "Comprar". */
+    @SuppressWarnings("unused")
+    private static boolean openShop(Player p, ArgumentIterator args) {
+        int templateId = args.nextInt();
+        org.starloco.locos.entity.npc.Npc npc = p.getCurMap().getNpcByTemplateId(templateId);
+        if (npc == null || p.getGameClient() == null) return false;
+        if (p.getExchangeAction() != null && p.getExchangeAction().getType() == ExchangeAction.TALKING_WITH) {
+            p.setExchangeAction(null);
