+
+    /** @return indice da classe (0..11) pelo nome, ou -1. Aceita acentos/maiusculas e "sacrieur". */
+    public static int byName(String name) {
+        String n = Normalizer.normalize(name, Normalizer.Form.NFD).replaceAll("[^A-Za-z]", "").toLowerCase();
+        if (n.equals("sacrieur")) n = "sacrier";
+        for (int i = 0; i < NAMES.length; i++)
+            if (NAMES[i].equals(n)) return i;
+        return -1;
+    }
+
+    /** Coloca na barra (posicoes 1..24) os feiticos da classe que o personagem conhece. */
+    public static int apply(Player player, int classIndex) {
+        int placed = player.setSpellBar(SPELLS[classIndex]);
+        SocketManager.GAME_SEND_SPELL_LIST(player);
+        DatabaseManager.get(PlayerData.class).update(player);
+        return placed;
+    }
+
+    /**
+     * LabTech: conhece cada feitico das 12 classes a partir do nivel em que a classe original o aprende, sempre no
+     * maior grau que o nivel permite (graus 1 a 5 no nivel de aprender, grau 6 cem niveis depois). Feiticos acima do
+     * nivel sao esquecidos. Nao envia pacotes nem salva. @return nomes dos feiticos novos.
+     */
+    public static List<String> sync(Player player) {
+        List<String> novos = new ArrayList<>();
+        int level = player.getLevel();
+        for (int c = 0; c < SPELLS.length; c++)
+            for (int i = 0; i < SPELLS[c].length; i++) {
+                int id = SPELLS[c][i];
+                Spell spell = World.world.getSort(id);
+                if (spell == null) continue;
+                Spell.SortStats atual = player.getSortStatBySortIfHas(id);
+                if (LEARN[c][i] > level) {
+                    if (atual != null) player.forgetSpellQuiet(id);
+                    continue;
+                }
+                int grau = 1;
+                for (int g = 2; g <= 6; g++) {
+                    Spell.SortStats ss = spell.getStatsByLevel(g);
+                    if (ss != null && ss.getReqLevel() <= level) grau = g;
+                }
+                if (spell.getStatsByLevel(grau) == null) continue;
+                if (atual == null) novos.add(NOMES[c][i]);
+                if (atual == null || atual.getLevel() != grau) player.learnSpell(id, grau, false, false, false);
+            }
+        return novos;
+    }
+
+    /** Feiticos da classe que o personagem ainda nao tem nivel para usar, do mais proximo ao mais distante. */
+    public static List<String> bloqueados(Player player, int classIndex) {
+        List<Integer> idx = new ArrayList<>();
+        for (int i = 0; i < SPELLS[classIndex].length; i++)
+            if (LEARN[classIndex][i] > player.getLevel()) idx.add(i);
+        idx.sort(Comparator.comparingInt(i -> LEARN[classIndex][i]));
+        List<String> out = new ArrayList<>();
+        for (int i : idx) out.add(NOMES[classIndex][i] + " (nv. " + LEARN[classIndex][i] + ")");
+        return out;
+    }
+}
diff --git a/src/org/starloco/locos/panel/DroneTalk.java b/src/org/starloco/locos/panel/DroneTalk.java
new file mode 100644
index 0000000..efc901c
--- /dev/null
+++ b/src/org/starloco/locos/panel/DroneTalk.java
@@ -0,0 +1,368 @@
+package org.starloco.locos.panel;
+
+import org.starloco.locos.area.SubArea;
+import org.starloco.locos.area.map.GameMap;
+import org.starloco.locos.client.Player;
+import org.starloco.locos.common.SocketManager;
+import org.starloco.locos.entity.monster.MonsterGrade;
+import org.starloco.locos.entity.monster.MonsterGroup;
+import org.starloco.locos.fight.Fight;
+import org.starloco.locos.fight.Fighter;
+import org.starloco.locos.game.scheduler.Updatable;
+import org.starloco.locos.game.world.World;
+import org.starloco.locos.kernel.Constant;
+import org.starloco.locos.kernel.Main;
+import org.starloco.locos.object.GameObject;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ThreadLocalRandom;
+
+/**
+ * Mundo LabTech: o Drone de IA (familiar 30024) fala sozinho, como um item vivo. Ele olha onde o dono est\u00e1 (mapa da
+ * ilha, regi\u00e3o, sub\u00e1rea), os monstros do mapa, a luta e o n\u00edvel, e comenta no chat ("Drone de IA : ..."), com bal\u00e3o
+ * em cima do personagem fora das lutas. As falas v\u00eam de scripts/labtech/drone_falas.tsv, gerado de content.py
+ * (DRONE); o arquivo \u00e9 relido quando muda, ent\u00e3o d\u00e1 para trocar as falas sem reiniciar.
+ */
+public class DroneTalk extends Updatable<Void> {
+
+    public static final DroneTalk instance = new DroneTalk(2000);
+
+    private static final int DRONE = 30024;
+    private static final String NOME = "Drone de IA";
+    private static final Path ARQUIVO = Paths.get("scripts", "labtech", "drone_falas.tsv");
+    private static final long PAUSA_EVENTOS = 60_000;   // luta: no m\u00e1ximo um coment\u00e1rio por minuto
+
+    private final Map<String, List<String>> falas = new HashMap<>();   // "grupo" ou "grupo:chave" -> frases
+    private final Map<String, String> nomes = new HashMap<>();         // "mob:id", "sa:id", "area:id" -> nome
+    private final List<String> familias = new ArrayList<>();           // chaves de fam\u00edlia de monstro, maiores antes
+    private long lidoEm = -1;
+    private int minSeg = 150, maxSeg = 300;
+
+    private final Map<Integer, Long> proxima = new ConcurrentHashMap<>();
+    private final Map<Integer, Evento> pendente = new ConcurrentHashMap<>();
+    private final Map<Integer, Long> ultimoEvento = new ConcurrentHashMap<>();
+    private final Map<Integer, Deque<String>> recentes = new ConcurrentHashMap<>();
+    private final Set<Integer> mudos = ConcurrentHashMap.newKeySet();
+
+    private static class Evento {
+        final long hora;
+        final String texto;
+
+        Evento(long hora, String texto) {
+            this.hora = hora;
+            this.texto = texto;
+        }
+    }
+
+    public DroneTalk(int wait) {
+        super(wait);
+    }
+
+    @Override
+    public void update() {
+        if (!this.verify()) return;
+        carregar();
+        if (falas.isEmpty()) return;
+        long agora = System.currentTimeMillis();
+        for (Player p : new ArrayList<>(World.world.getOnlinePlayers())) {
+            if (p == null) continue;
+            int id = p.getId();
+            if (!temDrone(p)) {
+                proxima.remove(id);
+                pendente.remove(id);
+                continue;
+            }
+            Evento ev = pendente.get(id);
+            if (ev != null) {
+                if (agora >= ev.hora) {
+                    pendente.remove(id);
+                    dizer(p, ev.texto);
+                }
+                continue;
+            }
+            if (p.getFight() != null) continue;
+            Long hora = proxima.get(id);
+            if (hora == null) {
+                agendar(id, agora);
+            } else if (agora >= hora) {
+                agendar(id, agora);
+                dizer(p, contexto(p));
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ eventos do jogo
+
+    public static void onLogin(Player p) {
+        instance.evento(p, instance.frase(p, "login", null), 9000, false);
+    }
+
+    public static void onLevelUp(Player p) {
+        instance.evento(p, instance.frase(p, "nivel", null), 1500, false);
+    }
+
+    /** Come\u00e7o de uma luta contra monstros: comenta o mais forte do outro lado (ou o chefe de um n\u00facleo). */
+    public static void onFightStart(Fight fight) {
+        MonsterGrade alvo = null;
+        int qtd = 0;
+        for (Fighter f : fight.getFighters(3)) {
+            MonsterGrade m = f.getMob();
+            if (m == null || f.isInvocation()) continue;
+            qtd++;
+            if (alvo == null || instance.tem("nucleo:" + m.getTemplate().getId()) || m.getLevel() > alvo.getLevel()
+                    && !instance.tem("nucleo:" + alvo.getTemplate().getId()))
+                alvo = m;
+        }
+        if (alvo == null) return;
+        for (Player p : jogadores(fight)) {
+            if (!instance.tem("nucleo:" + alvo.getTemplate().getId()) && ThreadLocalRandom.current().nextInt(100) >= 50)
+                continue;
+            String texto;
+            if (instance.tem("nucleo:" + alvo.getTemplate().getId())) {
+                texto = instance.frase(p, "nucleo:" + alvo.getTemplate().getId(), null);
+            } else {
+                Map<String, String> v = instance.vars(p);
+                v.put("mob", instance.nomeMob(alvo));
+                v.put("nivel_mob", String.valueOf(alvo.getLevel()));
+                v.put("qtd", String.valueOf(qtd));
+                texto = instance.frase(p, "luta_inicio", v);
+            }
+            instance.evento(p, texto, 2500, true);
+        }
+    }
+
+    /** Fim de uma luta contra monstros: vit\u00f3ria \u00e0s vezes, derrota sempre (o drone consola). */
+    public static void onFightEnd(Fight fight, Collection<Fighter> vencedores) {
+        MonsterGrade alvo = null;
+        for (Fighter f : fight.getFighters(3)) {
+            MonsterGrade m = f.getMob();
+            if (m != null && !f.isInvocation() && (alvo == null || m.getLevel() > alvo.getLevel()))
+                alvo = m;
+        }
+        Set<Integer> ganhou = new HashSet<>();
+        for (Fighter f : vencedores)
+            if (f != null && f.getPlayer() != null) ganhou.add(f.getPlayer().getId());
+        for (Player p : jogadores(fight)) {
+            boolean venceu = ganhou.contains(p.getId());
+            if (venceu && ThreadLocalRandom.current().nextInt(100) >= 40) continue;
+            Map<String, String> v = instance.vars(p);
+            v.put("mob", alvo != null ? instance.nomeMob(alvo) : "o monstro");
+            v.put("nivel_mob", alvo != null ? String.valueOf(alvo.getLevel()) : "?");
+            instance.ultimoEvento.remove(p.getId());   // o fim da luta sempre pode comentar
+            instance.evento(p, instance.frase(p, venceu ? "luta_vitoria" : "luta_derrota", v), 4000, true);
+        }
+    }
+
+    /** Comando .drone: fala agora; ".drone mudo" cala; ".drone volta" libera. Devolve a resposta para o chat. */
+    public static String comando(Player p, String arg) {
+        String a = arg == null ? "" : arg.trim().toLowerCase();
+        if (a.startsWith("mudo") || a.startsWith("quieto") || a.startsWith("sil")) {
+            instance.mudos.add(p.getId());
+            return "O Drone de IA ficou quieto. Use .drone volta para ele voltar a falar.";
+        }
+        if (a.startsWith("volta") || a.startsWith("fala")) {
+            instance.mudos.remove(p.getId());
+            return "O Drone de IA voltou a falar.";
+        }
+        if (!temDrone(p)) return "Equipe o Drone de IA como familiar para ele falar.";
+        if (instance.mudos.contains(p.getId())) return "O Drone de IA est\u00e1 quieto. Use .drone volta.";
+        instance.carregar();
+        instance.agendar(p.getId(), System.currentTimeMillis());
+        instance.dizer(p, instance.contexto(p));
+        return null;
+    }
+
+    // ------------------------------------------------------------------ o que dizer
+
+    private String contexto(Player p) {
+        GameMap map = p.getCurMap();
+        if (map == null) return frase(p, "geral", null);
+        ThreadLocalRandom r = ThreadLocalRandom.current();
+        String chaveMapa = "mapa:" + map.getId();
+        if (tem(chaveMapa)) return r.nextInt(100) < 55 ? frase(p, chaveMapa, null) : frase(p, "geral", null);
+        int sorteio = r.nextInt(100);
+        MonsterGrade mob = sorteio < 40 ? mobDoMapa(map) : null;
+        if (mob != null) return sobreMob(p, mob);
+        if (sorteio < 75) return sobreLocal(p, map);
+        return frase(p, "geral", null);
+    }
+
+    private String sobreLocal(Player p, GameMap map) {
+        SubArea sa = map.getSubArea();
+        int areaId = sa != null && sa.getArea() != null ? sa.getArea().getId() : -1;
+        String saNome = sa != null ? nomes.get("sa:" + sa.getId()) : null;
+        String areaNome = nomes.get("area:" + areaId);
+        boolean temArea = tem("area:" + areaId);
+        if (saNome == null && areaNome == null && !temArea) return frase(p, "geral", null);
+        Map<String, String> v = vars(p);
+        v.put("subarea", saNome != null ? saNome : areaNome != null ? areaNome : "este lugar");
+        v.put("area", areaNome != null ? areaNome : "algum canto do mundo");
+        if (temArea && (saNome == null || ThreadLocalRandom.current().nextInt(100) < 60))
+            return frase(p, "area:" + areaId, v);
+        return frase(p, "local", v);
+    }
+
+    private String sobreMob(Player p, MonsterGrade mob) {
+        int id = mob.getTemplate().getId();
+        if (tem("nucleo:" + id)) return frase(p, "nucleo:" + id, null);
+        String nome = nomeMob(mob);
+        Map<String, String> v = vars(p);
+        v.put("mob", nome);
+        v.put("nivel_mob", String.valueOf(mob.getLevel()));
+        String familia = familia(nome);
+        if (familia != null && ThreadLocalRandom.current().nextInt(100) < 65) return frase(p, "mob:" + familia, v);
+        int dif = mob.getLevel() - p.getLevel();
+        if (dif > 20) return frase(p, "mob_forte", v);
+        if (dif < -30) return frase(p, "mob_fraco", v);
+        return frase(p, "mob_generico", v);
+    }
+
+    private MonsterGrade mobDoMapa(GameMap map) {
+        try {
+            List<MonsterGrade> todos = new ArrayList<>();
+            for (MonsterGroup g : new ArrayList<>(map.getMobGroups().values()))
+                if (g != null) todos.addAll(g.getMobs().values());
+            todos.removeIf(Objects::isNull);
+            return todos.isEmpty() ? null : todos.get(ThreadLocalRandom.current().nextInt(todos.size()));
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private String nomeMob(MonsterGrade m) {
+        String n = nomes.get("mob:" + m.getTemplate().getId());
+        return n != null ? n : "um monstro";
+    }
+
+    private String familia(String nome) {
+        String n = nome.toLowerCase();
+        for (String f : familias)
+            if (n.contains(f.toLowerCase())) return f;
+        return null;
+    }
+
+    private Map<String, String> vars(Player p) {
+        Map<String, String> v = new HashMap<>();
+        v.put("nome", p.getName());
+        v.put("nivel", String.valueOf(p.getLevel()));
+        return v;
+    }
+
+    /** Uma frase do grupo, evitando repetir as \u00faltimas, com os marcadores {x} preenchidos. */
+    private String frase(Player p, String grupo, Map<String, String> v) {
+        carregar();
+        List<String> lista = falas.get(grupo);
+        if (lista == null || lista.isEmpty()) lista = falas.get("geral");
+        if (lista == null || lista.isEmpty()) return null;
+        Deque<String> rec = recentes.computeIfAbsent(p.getId(), k -> new ArrayDeque<>());
+        String escolhida = null;
+        for (int i = 0; i < 8; i++) {
+            escolhida = lista.get(ThreadLocalRandom.current().nextInt(lista.size()));
+            if (!rec.contains(escolhida)) break;
+        }
+        rec.addLast(escolhida);
+        while (rec.size() > 12) rec.removeFirst();
+        Map<String, String> vars = v != null ? v : vars(p);
+        String texto = escolhida;
+        for (Map.Entry<String, String> e : vars.entrySet())
+            texto = texto.replace("{" + e.getKey() + "}", e.getValue());
+        return texto;
+    }
+
+    // ------------------------------------------------------------------ infraestrutura
+
+    private boolean tem(String grupo) {
+        List<String> l = falas.get(grupo);
+        return l != null && !l.isEmpty();
+    }
+
+    private static boolean temDrone(Player p) {
+        GameObject pet = p.getObjetByPos(Constant.ITEM_POS_FAMILIER);
+        return pet != null && pet.getTemplate() != null && pet.getTemplate().getId() == DRONE;
+    }
+
+    private static List<Player> jogadores(Fight fight) {
+        List<Player> out = new ArrayList<>();
+        for (Fighter f : fight.getFighters(3)) {
+            Player p = f.getPlayer();
+            if (p != null && f.getId() == p.getId() && p.isOnline() && temDrone(p) && !out.contains(p)) out.add(p);
+        }
+        return out;
+    }
+
+    private void agendar(int id, long agora) {
+        int seg = minSeg + ThreadLocalRandom.current().nextInt(Math.max(1, maxSeg - minSeg + 1));
+        proxima.put(id, agora + seg * 1000L);
+    }
+
+    private void evento(Player p, String texto, long atraso, boolean comPausa) {
+        if (p == null || texto == null || !temDrone(p)) return;
+        long agora = System.currentTimeMillis();
+        if (comPausa) {
+            Long ult = ultimoEvento.get(p.getId());
+            if (ult != null && agora - ult < PAUSA_EVENTOS) return;
+            ultimoEvento.put(p.getId(), agora);
+        }
+        pendente.put(p.getId(), new Evento(agora + atraso, texto));
+        long depois = agora + atraso + minSeg * 1000L / 2;
+        proxima.merge(p.getId(), depois, Math::max);
+    }
+
+    private void dizer(Player p, String texto) {
+        if (texto == null || texto.isEmpty() || mudos.contains(p.getId()) || !p.isOnline()) return;
+        SocketManager.send(p, "cMK|" + p.getId() + "|" + NOME + "|" + texto + "|");
+    }
+
+    private synchronized void carregar() {
+        long mod = -3;
+        try {
+            if (!Files.exists(ARQUIVO)) return;
+            mod = Files.getLastModifiedTime(ARQUIVO).toMillis();
+            if (mod == lidoEm) return;
+            Map<String, List<String>> f = new HashMap<>();
+            Map<String, String> n = new HashMap<>();
+            Set<String> fam = new HashSet<>();
+            for (String linha : Files.readAllLines(ARQUIVO, StandardCharsets.UTF_8)) {
+                if (linha.isEmpty() || linha.startsWith("#")) continue;
+                String[] c = linha.split("\t", 3);
+                if (c.length < 3) continue;
+                switch (c[0]) {
+                    case "config":
+                        if (c[1].equals("intervalo") && c[2].contains("-")) {
+                            String[] mm = c[2].split("-");
+                            minSeg = Integer.parseInt(mm[0].trim());
+                            maxSeg = Math.max(minSeg, Integer.parseInt(mm[1].trim()));
+                        }
+                        break;
+                    case "nome_mob": n.put("mob:" + c[1], c[2]); break;
+                    case "nome_sa": n.put("sa:" + c[1], c[2]); break;
+                    case "nome_area": n.put("area:" + c[1], c[2]); break;
+                    default:
+                        String chave = c[1].isEmpty() ? c[0] : c[0] + ":" + c[1];
+                        f.computeIfAbsent(chave, k -> new ArrayList<>()).add(c[2]);
+                        if (c[0].equals("mob")) fam.add(c[1]);
+                }
+            }
+            List<String> familiasOrdenadas = new ArrayList<>(fam);
+            familiasOrdenadas.sort((a, b) -> b.length() - a.length());
+            synchronized (this) {
+                falas.clear();
+                falas.putAll(f);
+                nomes.clear();
+                nomes.putAll(n);
+                familias.clear();
+                familias.addAll(familiasOrdenadas);
+            }
+            lidoEm = mod;
+            Main.logger.info("Drone de IA: " + f.values().stream().mapToInt(List::size).sum() + " falas carregadas");
+        } catch (Exception e) {
+            Main.logger.error("Drone de IA: falha ao ler " + ARQUIVO, e);
+            lidoEm = mod;   // tenta de novo quando o arquivo mudar
+        }
+    }
+}
diff --git a/src/org/starloco/locos/panel/Figurantes.java b/src/org/starloco/locos/panel/Figurantes.java
new file mode 100644
index 0000000..47cb00e
--- /dev/null
+++ b/src/org/starloco/locos/panel/Figurantes.java
@@ -0,0 +1,471 @@
+package org.starloco.locos.panel;
+
+import org.starloco.locos.area.SubArea;
+import org.starloco.locos.area.map.GameCase;
+import org.starloco.locos.area.map.GameMap;
+import org.starloco.locos.client.Player;
+import org.starloco.locos.common.PathFinding;
+import org.starloco.locos.common.SocketManager;
+import org.starloco.locos.entity.monster.Monster;
+import org.starloco.locos.entity.monster.MonsterGrade;
+import org.starloco.locos.entity.monster.MonsterGroup;
+import org.starloco.locos.game.scheduler.Updatable;
+import org.starloco.locos.game.world.World;
+import org.starloco.locos.kernel.Main;
+import org.starloco.locos.object.ObjectTemplate;
+import org.starloco.locos.util.generator.NameGenerator;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.*;
+import java.util.concurrent.ThreadLocalRandom;
+
+/**
+ * Mundo LabTech: figurantes, personagens que imitam jogadores. Eles aparecem perto de quem est\u00e1 jogando, andam pelo
+ * mapa, sentam, conversam (bal\u00e3o em cima deles), ca\u00e7am os monstros do mapa (somem na luta, como um jogador de
+ * verdade, e voltam com o resultado), contam o que dropou e anunciam vendas
+ * no canal de Itens. N\u00e3o s\u00e3o contas nem clientes: s\u00e3o sprites de jogador que o servidor desenha e move.
+ * Falas e apelidos v\u00eam de scripts/labtech/chat_vivo.tsv (FIGURANTES em content.py).
+ */
+public class Figurantes extends Updatable<Void> {
+
+    public static final Figurantes instance = new Figurantes(2000);
+
+    private static final Path ARQUIVO = Paths.get("scripts", "labtech", "chat_vivo.tsv");
+    private static final int ID_BASE = 2_000_000;
+    private static final String[] CLASSES = {"", "Feca", "Osamodas", "Enutrof", "Sram", "Xelor", "Ecaflip", "Eniripsa",
+            "Iop", "Cra", "Sadida", "Sacrier", "Pandawa", "LabTech"};
+    private static final int[][] PALETAS = {
+            {0x2A1C12, 0xF0F0EC, 0x19C8D2}, {0x3B2A1A, 0x8B1E1E, 0xE8C15A}, {0x1E2B4A, 0x4A7BC8, 0xDADADA},
+            {0x2E4A1E, 0x7FB041, 0x5A3A1A}, {0x4A1E4A, 0xB05AC8, 0xF2D8F2}, {0x121212, 0x3A3A3A, 0xC81E1E},
+            {0x5A3A1A, 0xE8A04A, 0x1E1E1E}, {0xF2E6C8, 0x2A6A8A, 0x8A2A2A}, {0x6A4A2A, 0x2A8A6A, 0xE8E8E8}};
+
+    private static class Fig {
+        int id, classe, sexo, nivel, cor;
+        String nome, roupa = ",,,,";
+        GameMap mapa, mapaLuta;
+        int cell = -1;
+        long proxima, saiEm, fimLuta, ultimoDrop, ultimaFala;
+        MonsterGroup alvo, lutando;
+    }
+
+    private final List<Fig> figs = new ArrayList<>();
+    private final List<String> apelidos = new ArrayList<>();
+    private final Map<String, List<String>> falas = new HashMap<>();
+    private final List<Integer> itens = new ArrayList<>();
+    private final Map<Integer, String> nomeMob = new HashMap<>();
+    private final List<Object[]> respawns = new ArrayList<>();
+    private final Map<Integer, List<GameMap>> mapasPorSa = new HashMap<>();
+    private int quantidade = 10;
+    private long lidoEm = -1, proximaDistribuicao, proximaVenda;
+
+    public Figurantes(int wait) {
+        super(wait);
+    }
+
+    @Override
+    public void update() {
+        if (!this.verify()) return;
+        carregar();
+        if (falas.isEmpty()) return;
+        if (figs.isEmpty()) criar();
+        long agora = System.currentTimeMillis();
+        try {
+            respawnTick(agora);
+            if (agora > proximaDistribuicao) {
+                proximaDistribuicao = agora + 20_000;
+                distribuir();
+            }
+            for (Fig f : figs) tick(f, agora);
+            if (proximaVenda == 0) proximaVenda = agora + 90_000;
+            if (agora > proximaVenda) {
+                proximaVenda = agora + 1000L * (150 + ThreadLocalRandom.current().nextInt(150));
+                anunciarVenda();
+            }
+        } catch (Exception ex) {
+            Main.logger.error("Figurantes", ex);
+        }
+    }
+
+    /** Quem carrega um mapa v\u00ea os figurantes que est\u00e3o nele. */
+    public static void onMapLoad(Player p) {
+        if (p == null || p.getCurMap() == null) return;
+        for (Fig f : instance.figs)
+            if (f.mapa == p.getCurMap() && f.lutando == null) p.send("GM|+" + instance.gm(f));
+    }
+
+    // ------------------------------------------------------------------ comportamento
+    private void tick(Fig f, long agora) {
+        if (f.lutando != null) {
+            if (agora > f.fimLuta) terminarLuta(f, agora);
+            return;
+        }
+        if (f.mapa == null || agora < f.proxima) return;
+        if (agora > f.saiEm) {
+            if (ThreadLocalRandom.current().nextInt(100) < 40) falar(f, "tchau", null, null);
+            tirar(f);
+            return;
+        }
+        f.proxima = agora + 1000L * (4 + ThreadLocalRandom.current().nextInt(9));
+        if (f.alvo != null) {
+            if (f.mapa.getMobGroups().get(f.alvo.getId()) == f.alvo) comecarLuta(f, agora);
+            f.alvo = null;
+            return;
+        }
+        int r = ThreadLocalRandom.current().nextInt(100);
+        MonsterGroup g = r < 35 ? grupoLivre(f.mapa) : null;
+        if (g != null) {
+            int destino = celulaPerto(f.mapa, g.getCellId());
+            int passos = destino > 0 ? mover(f, destino) : 0;
+            if (passos > 0) {
+                f.alvo = g;
+                f.proxima = System.currentTimeMillis() + 1500 + 450L * passos;
+            }
+        } else if (r >= 35 && r < 45 && agora - f.ultimaFala > 60_000) {
+            falar(f, "passeio", null, null);
+        } else if (r >= 45 && r < 52) {
+            SocketManager.GAME_SEND_eUK_PACKET_TO_MAP(f.mapa, f.id, 1);   // senta
+        } else {
+            int destino = f.mapa.getRandomNearFreeCellId(f.cell);
+            if (destino > 0 && mover(f, destino) == 0) {
+                destino = f.mapa.getRandomFreeCellId();   // preso num canto: tenta um lugar qualquer do mapa
+                if (destino > 0) mover(f, destino);
+            }
+        }
+    }
+
+    private void comecarLuta(Fig f, long agora) {
+        MonsterGroup g = f.alvo;
+        GameMap m = f.mapa;
+        m.getMobGroups().remove(g.getId());
+        enviar(m, "GM|-" + g.getId());
+        falar(f, "luta", g, null);
+        enviar(m, "GM|-" + f.id);
+        f.lutando = g;
+        f.mapaLuta = m;
+        f.fimLuta = agora + 1000L * (25 + ThreadLocalRandom.current().nextInt(45));
+    }
+
+    private void terminarLuta(Fig f, long agora) {
+        MonsterGroup g = f.lutando;
+        GameMap m = f.mapaLuta;
+        f.lutando = null;
+        boolean venceu = ThreadLocalRandom.current().nextInt(100) < 85;
+        int cell = m.getRandomNearFreeCellId(f.cell);
+        colocar(f, m, cell > 0 ? cell : f.cell, false);
+        if (venceu && ThreadLocalRandom.current().nextInt(4) == 0 && f.nivel < 200) f.nivel++;
+        falar(f, venceu ? "venci" : "perdi", g, null);
+        if (venceu && !jogadores(m).isEmpty() && agora - f.ultimoDrop > 4 * 60_000L && ThreadLocalRandom.current().nextInt(100) < 45)
+            dropar(f, g);
+        respawns.add(new Object[]{m, g, agora + 1000L * (venceu ? 45 + ThreadLocalRandom.current().nextInt(45) : 8)});
+    }
+
+    /** O figurante conta no mapa um item que dropou (s\u00f3 fala: n\u00e3o interage com quem est\u00e1 jogando). */
+    private void dropar(Fig f, MonsterGroup g) {
+        List<MonsterGrade> mobs = new ArrayList<>(g.getMobs().values());
+        if (mobs.isEmpty()) return;
+        Monster m = mobs.get(ThreadLocalRandom.current().nextInt(mobs.size())).getTemplate();
+        if (m == null || m.getDrops() == null || m.getDrops().isEmpty()) return;
+        List<ObjectTemplate> bons = new ArrayList<>(), todos = new ArrayList<>();
+        for (World.Drop d : m.getDrops()) {
+            ObjectTemplate t = World.world.getObjTemplate(d.getObjectId());
+            if (t == null) continue;
+            todos.add(t);
+            if (t.getPanoId() > 0 || (t.getType() >= 1 && t.getType() <= 11) || t.getType() == 16 || t.getType() == 17) bons.add(t);
+        }
+        List<ObjectTemplate> escolha = !bons.isEmpty() && ThreadLocalRandom.current().nextInt(100) < 60 ? bons : todos;
+        if (escolha.isEmpty()) return;
+        ObjectTemplate t = escolha.get(ThreadLocalRandom.current().nextInt(escolha.size()));
+        f.ultimoDrop = System.currentTimeMillis();
+        falar(f, "drop", null, Collections.singletonList(t.getId()));
+    }
+
+    private void respawnTick(long agora) {
+        Iterator<Object[]> it = respawns.iterator();
+        while (it.hasNext()) {
+            Object[] r = it.next();
+            if (agora < (Long) r[2]) continue;
+            it.remove();
+            GameMap m = (GameMap) r[0];
+            MonsterGroup g = (MonsterGroup) r[1];
+            if (m.getMobGroups().containsKey(g.getId())) continue;
+            int cell = m.getRandomFreeCellId();
+            if (cell > 0) g.setCellId(cell);
+            m.respawnGroup(g);
+        }
+    }
+
+    /** Cada jogador v\u00ea de um a dois figurantes na sub\u00e1rea onde est\u00e1; os que sobram esperam. */
+    private void distribuir() {
+        for (Player p : new ArrayList<>(World.world.getOnlinePlayers())) {
+            if (p == null || !p.isOnline() || p.getFight() != null || p.getCurMap() == null) continue;
+            GameMap mapa = p.getCurMap();
+            SubArea sa = mapa.getSubArea();
+            if (sa == null || !elegivel(mapa)) continue;
+            int perto = 0;
+            for (Fig f : figs) {
+                GameMap m = f.lutando != null ? f.mapaLuta : f.mapa;
+                if (m != null && m.getSubArea() == sa) perto++;
+            }
+            int alvo = mapa.getMobGroups().isEmpty() ? 1 : 2;
+            if (perto >= alvo) continue;
+            List<Fig> livres = new ArrayList<>();
+            for (Fig f : figs)
+                if (f.mapa == null && f.lutando == null) livres.add(f);
+            if (livres.isEmpty()) continue;
+            Fig f = livres.get(ThreadLocalRandom.current().nextInt(livres.size()));
+            GameMap destino = mapa;
+            if (ThreadLocalRandom.current().nextInt(100) >= 55) {
+                List<GameMap> lista = mapasDaSa(sa.getId());
+                if (!lista.isEmpty()) destino = lista.get(ThreadLocalRandom.current().nextInt(lista.size()));
+            }
+            f.nivel = Math.max(1, Math.min(200, p.getLevel() + ThreadLocalRandom.current().nextInt(31) - 15));
+            vestir(f);
+            int cell = destino.getRandomFreeCellId();
+            if (cell > 0) colocar(f, destino, cell, true);
+        }
+    }
+
+    private boolean elegivel(GameMap m) {
+        for (MonsterGroup g : m.getMobGroups().values())
+            if (g.isFix()) return false;   // salas de calabou\u00e7o
+        return m.getMountPark() == null;
+    }
+
+    private List<GameMap> mapasDaSa(int sa) {
+        return mapasPorSa.computeIfAbsent(sa, k -> {
+            List<GameMap> l = new ArrayList<>();
+            for (GameMap m : World.world.getMaps())
+                if (m.getSubArea() != null && m.getSubArea().getId() == sa && !m.getMobGroups().isEmpty() && elegivel(m)) l.add(m);
+            return l;
+        });
+    }
+
+    private MonsterGroup grupoLivre(GameMap m) {
+        List<MonsterGroup> l = new ArrayList<>();
+        for (MonsterGroup g : m.getMobGroups().values())
+            if (!g.isFix() && !g.getMobs().isEmpty() && ChatVivo.multiplicadorDropGrupo(m, g) == 1.0) l.add(g);
+        return l.isEmpty() ? null : l.get(ThreadLocalRandom.current().nextInt(l.size()));
+    }
+
+    private int celulaPerto(GameMap m, int cell) {
+        int c = m.getRandomNearFreeCellId(cell);
+        return c > 0 ? c : cell;
+    }
+
+    // ------------------------------------------------------------------ apar\u00eancia e pacotes
+    private void criar() {
+        List<String> nomes = new ArrayList<>(apelidos);
+        Collections.shuffle(nomes);
+        for (int i = 0; i < quantidade; i++) {
+            Fig f = new Fig();
+            f.id = ID_BASE + i;
+            f.classe = ThreadLocalRandom.current().nextInt(100) < 8 ? 13 : 1 + ThreadLocalRandom.current().nextInt(12);
+            f.sexo = ThreadLocalRandom.current().nextInt(2);
+            f.cor = ThreadLocalRandom.current().nextInt(PALETAS.length);
+            f.nome = i < nomes.size() ? nomes.get(i) : NameGenerator.nameGenerator.compose(2 + ThreadLocalRandom.current().nextInt(2));
+            f.nivel = 1;
+            figs.add(f);
+        }
+    }
+
+    private void vestir(Fig f) {
+        int arma = sortearItem(f.nivel, 2, 3, 4, 5, 6, 7, 8, 19), chapeu = sortearItem(f.nivel, 16), capa = sortearItem(f.nivel, 17, 81);
+        f.roupa = hex(f.classe == 13 ? 30001 : arma) + "," + hex(f.classe == 13 ? 30027 : chapeu) + "," + hex(f.classe == 13 ? 30028 : capa) + ",,";
+    }
+
+    private int sortearItem(int nivel, int... tipos) {
+        List<Integer> l = new ArrayList<>();
+        for (int id : itens) {
+            ObjectTemplate t = World.world.getObjTemplate(id);
+            if (t == null || t.getLevel() > nivel || t.getLevel() < nivel - 40) continue;
+            for (int tp : tipos)
+                if (t.getType() == tp) {
+                    l.add(id);
+                    break;
+                }
+        }
+        return l.isEmpty() || ThreadLocalRandom.current().nextInt(100) < 15 ? -1 : l.get(ThreadLocalRandom.current().nextInt(l.size()));
+    }
+
+    private static String hex(int id) {
+        return id > 0 ? Integer.toHexString(id) : "";
+    }
+
+    /** Mesmo formato de Player.parseToGM: c\u00e9lula;dire\u00e7\u00e3o;0;id;nome;classe;gfx^tamanho;sexo;alinhamento;cores;roupa;aura... */
+    private String gm(Fig f) {
+        int[] c = PALETAS[f.cor];
+        int aura = f.nivel > 199 ? 2 : f.nivel > 99 ? 1 : 0;
+        return f.cell + ";" + (1 + 2 * ThreadLocalRandom.current().nextInt(4)) + ";0;" + f.id + ";" + f.nome + ";" + f.classe + ";"
+                + (f.classe * 10 + f.sexo) + "^100;" + f.sexo + ";0,0,0," + (f.nivel + f.id) + ";"
+                + Integer.toHexString(c[0]) + ";" + Integer.toHexString(c[1]) + ";" + Integer.toHexString(c[2]) + ";"
+                + f.roupa + ";" + aura + ";;;;;0;;0;";
+    }
+
+    private void colocar(Fig f, GameMap m, int cell, boolean chegando) {
+        f.mapa = m;
+        f.cell = cell;
+        enviar(m, "GM|+" + gm(f));
+        long agora = System.currentTimeMillis();
+        f.proxima = agora + 1000L * (3 + ThreadLocalRandom.current().nextInt(6));
+        if (chegando) {
+            f.saiEm = agora + 1000L * (180 + ThreadLocalRandom.current().nextInt(360));
+            if (ThreadLocalRandom.current().nextInt(100) < 45) falar(f, "oi", null, null);
+        }
+    }
+
+    private void tirar(Fig f) {
+        if (f.mapa != null) enviar(f.mapa, "GM|-" + f.id);
+        f.mapa = null;
+        f.alvo = null;
+    }
+
+    /** Anda at\u00e9 a c\u00e9lula e devolve quantos passos deu (0 = n\u00e3o achou caminho). */
+    private int mover(Fig f, int destino) {
+        List<Character> dirs = caminho(f.mapa, f.cell, destino);
+        if (dirs == null || dirs.isEmpty()) return 0;
+        // formato do cliente: "a" + c\u00e9lula inicial, depois dire\u00e7\u00e3o + c\u00e9lula onde cada reta termina
+        StringBuilder sb = new StringBuilder("a").append(World.world.getCryptManager().cellID_To_Code(f.cell));
+        int c = f.cell;
+        for (int i = 0; i < dirs.size(); i++) {
+            c = PathFinding.GetCaseIDFromDirection(c, dirs.get(i), f.mapa, true);
+            if (i == dirs.size() - 1 || !dirs.get(i + 1).equals(dirs.get(i)))
+                sb.append(dirs.get(i)).append(World.world.getCryptManager().cellID_To_Code(c));
+        }
+        for (Player p : jogadores(f.mapa))
+            SocketManager.GAME_SEND_GA_PACKET(p.getGameClient(), "0", "1", String.valueOf(f.id), sb.toString());
+        f.cell = destino;
+        return dirs.size();
+    }
+
+    /**
+     * Busca em largura s\u00f3 nas diagonais (b, d, f, h), que valem em qualquer mapa. O PathFinding do StarLoco n\u00e3o
+     * serve aqui: o getNearestCellAround dele s\u00f3 aceita c\u00e9lulas da borda e quase nunca acha caminho.
+     */
+    private static List<Character> caminho(GameMap m, int de, int ate) {
+        if (m == null || de == ate || m.getCase(ate) == null) return null;
+        char[] dirs = {'b', 'd', 'f', 'h'};
+        Map<Integer, Integer> veio = new HashMap<>();
+        Map<Integer, Character> pelo = new HashMap<>();
+        ArrayDeque<Integer> fila = new ArrayDeque<>();
+        fila.add(de);
+        veio.put(de, -1);
+        while (!fila.isEmpty() && veio.size() < 600) {
+            int c = fila.poll();
+            if (c == ate) break;
+            for (char d : dirs) {
+                int n = PathFinding.GetCaseIDFromDirection(c, d, m, true);
+                if (n < 0 || veio.containsKey(n)) continue;
+                GameCase gc = m.getCase(n);
+                if (gc == null || !gc.isWalkable(false)) continue;
+                veio.put(n, c);
+                pelo.put(n, d);
+                fila.add(n);
+            }
+        }
+        if (!veio.containsKey(ate)) return null;
+        LinkedList<Character> l = new LinkedList<>();
+        for (int c = ate; c != de; c = veio.get(c)) l.addFirst(pelo.get(c));
+        return l.size() > 40 ? null : l;
+    }
+
+    private List<Player> jogadores(GameMap m) {
+        List<Player> l = new ArrayList<>();
+        if (m == null) return l;
+        for (Player p : m.getPlayers())
+            if (p != null && p.isOnline() && p.getFight() == null && p.getGameClient() != null) l.add(p);
+        return l;
+    }
+
+    private void enviar(GameMap m, String pacote) {
+        for (Player p : jogadores(m)) p.send(pacote);
+    }
+
+    private void falar(Fig f, String tipo, MonsterGroup g, List<Integer> itens) {
+        List<String> l = falas.get(tipo);
+        if (l == null || l.isEmpty() || f.mapa == null) return;
+        List<Player> ali = jogadores(f.mapa);
+        if (ali.isEmpty()) return;
+        String t = l.get(ThreadLocalRandom.current().nextInt(l.size()));
+        String mob = "monstro";
+        if (g != null && !g.getMobs().isEmpty()) {
+            MonsterGrade m = g.getMobs().values().iterator().next();
+            mob = nomeMob.getOrDefault(m.getTemplate().getId(), "monstro");
+        }
+        t = t.replace("{mob}", mob).replace("{nivel}", String.valueOf(f.nivel)).replace("{classe}", CLASSES[f.classe])
+                .replace("{item}", "\u00b00");
+        String pacote = "cMK|" + f.id + "|" + f.nome + "|" + t.replace('|', '/') + "|" + links(itens);
+        for (Player p : ali) p.send(pacote);
+        f.ultimaFala = System.currentTimeMillis();
+    }
+
+    private String links(List<Integer> ids) {
+        StringBuilder sb = new StringBuilder();
+        if (ids != null)
+            for (int id : ids) {
+                ObjectTemplate t = World.world.getObjTemplate(id);
+                if (t == null) continue;
+                if (sb.length() > 0) sb.append('!');
+                sb.append(id).append('!').append(t.getStrTemplate() == null ? "" : t.getStrTemplate());
+            }
+        return sb.toString();
+    }
+
+    /** Um figurante anuncia uma venda (ou compra) no canal de Itens, com um item perto do n\u00edvel de quem est\u00e1 jogando. */
+    private void anunciarVenda() {
+        List<Player> on = new ArrayList<>(World.world.getOnlinePlayers());
+        on.removeIf(x -> x == null || !x.isOnline() || ChatVivo.chatDesligado(x));
+        if (on.isEmpty() || figs.isEmpty()) return;
+        Player ref = on.get(ThreadLocalRandom.current().nextInt(on.size()));
+        List<Integer> l = new ArrayList<>();
+        for (int id : itens) {
+            ObjectTemplate t = World.world.getObjTemplate(id);
+            if (t != null && Math.abs(t.getLevel() - ref.getLevel()) <= 20) l.add(id);
+        }
+        List<String> frases = falas.get("venda");
+        if (l.isEmpty() || frases == null || frases.isEmpty()) return;
+        int item = l.get(ThreadLocalRandom.current().nextInt(l.size()));
+        ObjectTemplate t = World.world.getObjTemplate(item);
+        Fig f = figs.get(ThreadLocalRandom.current().nextInt(figs.size()));
+        long preco = Math.max(1, (long) t.getLevel() * t.getLevel() * (20 + ThreadLocalRandom.current().nextInt(60)) / 1000);
+        String texto = frases.get(ThreadLocalRandom.current().nextInt(frases.size()))
+                .replace("{item}", "\u00b00").replace("{preco}", String.valueOf(preco)).replace('|', '/');
+        String pacote = "cMK:|" + f.id + "|" + f.nome + "|" + texto + "|" + links(Collections.singletonList(item));
+        for (Player p : on) p.send(pacote);
+    }
+
+    // ------------------------------------------------------------------ dados
+    private synchronized void carregar() {
+        long mod = -3;
+        try {
+            if (!Files.exists(ARQUIVO)) return;
+            mod = Files.getLastModifiedTime(ARQUIVO).toMillis();
+            if (mod == lidoEm) return;
+            apelidos.clear();
+            falas.clear();
+            itens.clear();
+            nomeMob.clear();
+            for (String linha : Files.readAllLines(ARQUIVO, StandardCharsets.UTF_8)) {
+                String[] c = linha.split("\t", -1);
+                if (c.length < 3) continue;
+                try {
+                    switch (c[0]) {
+                        case "fig_config": if (c[1].equals("quantidade")) quantidade = Integer.parseInt(c[2]); break;
+                        case "fig_apelido": apelidos.add(c[2]); break;
+                        case "fig_fala": falas.computeIfAbsent(c[1], k -> new ArrayList<>()).add(c[2]); break;
+                        case "item": itens.add(Integer.parseInt(c[1])); break;
+                        case "nome_mob": nomeMob.put(Integer.parseInt(c[1]), c[2]); break;
+                        default:
+                    }
+                } catch (Exception ignored) {
+                }
+            }
+            lidoEm = mod;
+        } catch (Exception ex) {
+            Main.logger.error("Figurantes: falha ao ler " + ARQUIVO, ex);
+            lidoEm = mod;
+        }
+    }
+}
