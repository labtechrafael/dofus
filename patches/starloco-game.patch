+        p.setExchangeAction(new ExchangeAction<>(ExchangeAction.TRADING_WITH_NPC, npc.getId()));
+        SocketManager.GAME_SEND_ECK_PACKET(p.getGameClient(), 0, String.valueOf(npc.getId()));
+        SocketManager.GAME_SEND_ITEM_VENDOR_LIST_PACKET(p.getGameClient(), npc.getTemplate().salesList(p));
+        return true;
+    }
