+    private void iniciarEvento(Player ref) {
+        int nivel = ref.getLevel();
+        List<Integer> sas = new ArrayList<>();
+        for (Map.Entry<Integer, Zona> z : zonas.entrySet())
+            if (z.getValue().min <= nivel + 10 && z.getValue().max >= nivel - 15 && spotNaZona(z.getKey()) != null) sas.add(z.getKey());
+        if (sas.isEmpty()) return;
+        int sa = sas.get(ThreadLocalRandom.current().nextInt(sas.size()));
+        Spot s = spotNaZona(sa);
+        GameMap map = World.world.getMap(s.mapa);
+        if (map == null) return;
+        String[] tipos = {"invasao", "chefe", "chuva"};
+        String tipo = tipos[ThreadLocalRandom.current().nextInt(tipos.length)];
+        Zona z = zonas.get(sa);
+        Evento ev = new Evento();
+        ev.tipo = tipo;
+        ev.sa = sa;
+        ev.mapa = s.mapa;
+        ev.x = s.x;
+        ev.y = s.y;
+        ev.zona = z.nome;
+        Map<String, String> v = new HashMap<>();
+        v.put("zona", z.nome);
+        v.put("x", String.valueOf(s.x));
+        v.put("y", String.valueOf(s.y));
+        v.put("mapa", String.valueOf(s.mapa));
+        v.put("faixa", z.min + "\u2013" + z.max);
+        v.put("minutos", "20");
+        List<Integer> mobsZona = new ArrayList<>();
+        for (Map.Entry<Integer, List<Spot>> en : vivos.entrySet())
+            for (Spot x : en.getValue())
+                if (x.sa == sa && !mobsZona.contains(en.getKey())) mobsZona.add(en.getKey());
+        if (mobsZona.isEmpty()) return;
+        StringBuilder grupo = new StringBuilder();
+        if (tipo.equals("invasao")) {
+            int mob = mobsZona.get(ThreadLocalRandom.current().nextInt(mobsZona.size()));
+            for (int i = 0; i < 8; i++) grupo.append(mob).append(",1,9999;");
+            v.put("mob", nomeMob(mob));
+            v.put("qtd", "8");
+        } else if (tipo.equals("chefe")) {
+            List<Chefe> bons = new ArrayList<>();
+            for (Chefe c : chefes.values())
+                if (c.min <= nivel + 20 && c.max >= nivel - 30 && World.world.getMonstre(c.id) != null) bons.add(c);
+            if (bons.isEmpty()) {
+                tipo = "chuva";
+                ev.tipo = tipo;
+            } else {
+                Chefe c = bons.get(ThreadLocalRandom.current().nextInt(bons.size()));
+                grupo.append(c.id).append(",1,9999;");
+                for (int i = 0; i < 3; i++) grupo.append(mobsZona.get(ThreadLocalRandom.current().nextInt(mobsZona.size()))).append(",1,9999;");
+                v.put("mob", nomeMob(c.id));
+                v.put("nivel_mob", c.min + "\u2013" + c.max);
+            }
+        }
+        if (!tipo.equals("chuva")) {
+            int cell = map.getRandomFreeCellId();
+            if (cell <= 0) return;
+            MonsterGroup g = map.spawnGroupOnCommand(cell, grupo.toString(), true);
+            if (g == null || g.getMobs().isEmpty()) return;
+            ev.grupo = g.getId();
+            ev.fim = System.currentTimeMillis() + 30 * 60_000L;
+        } else {
+            ev.fim = System.currentTimeMillis() + 20 * 60_000L;
+        }
+        evento = ev;
+        anunciarTodos(CHEFES, eventosTxt.get(tipo), v, null);
+    }
