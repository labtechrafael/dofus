+    public static void onFightEnd(Fight fight, Collection<Fighter> vencedores) {
+        try {
+            Set<Integer> ganhou = new HashSet<>();
+            for (Fighter f : vencedores)
+                if (f != null && f.getPlayer() != null) ganhou.add(f.getPlayer().getId());
+            Set<Integer> mobs = new HashSet<>();
+            for (Fighter f : fight.getFighters(3))
+                if (f.getMob() != null) mobs.add(f.getMob().getTemplate().getId());
+            int mapa = fight.getMapOld() != null ? fight.getMapOld().getId() : -1;
+            Evento ev = instance.evento;
+            boolean doEvento = ev != null && ev.grupo != Integer.MIN_VALUE && mapa == ev.mapa && fight.getMobGroup() != null
+                    && fight.getMobGroup().getId() == ev.grupo;
+            for (Player p : jogadores(fight)) {
+                if (!ganhou.contains(p.getId())) continue;
+                instance.calaboucoVencido(p, mapa, mobs);
+                if (doEvento) {
+                    Map<String, String> v = instance.vars(p);
+                    v.put("zona", ev.zona);
+                    instance.anunciarTodos(CHEFES, instance.eventosTxt.get("vencido"), v, null);
+                    instance.encerrarEvento(false);
+                }
+            }
+        } catch (Exception ex) {
+            Main.logger.error("Chat vivo: fim de luta", ex);
+        }
